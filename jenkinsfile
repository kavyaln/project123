pipeline {
agent any 
	stages{ 
	stage ('clone'){
		steps {
		git branch: 'main', url: 'https://github.com/kavyaln/project123.git'
			}
			}
	stage ('Build') {
		steps {
		sh 'mvn clean install'
		}
			}
	stage ('test'){
		steps {
		sh 'mvn test'
		sh '''
		cat > test-results.xml <<EOF
		<testsuite name="My Project test" tests="1" failures="0">
 		<testcase name="Project test"/>
		</testsuite>
		EOF
		'''

		junit 'test-results.xml'
			}
			}
	stage ('archiveArtifact') {
		steps{
		archiveArtifacts artifacts: 'target/project123-1.0.war',
		fingerprint: true
		}
		}
	stage ('deploy') {
		steps {
		sh '''
		cp target/project123-1.0.war /var/lib/tomcat/webapps/
		'''
		}
			}
		}
	post {
		success {
		echo "Pipeline completed successfully"
		}
		failure {
		echo "pipeline failed"
			}
		}
}
